graph LR
    %% Atores (estilizados como círculos/bonecos)
    Cliente((Cliente))
    Cozinheiro((Cozinheiro))
    Operadora[((Operadora Cartão/PIX))]

    subgraph "Sistema do Totem"
        UC1([Fazer Pedido])
        UC2([Realizar Pagamento])
        UC3([Atualizar Fidelidade])
        UC4([Exibir Pedido na Cozinha])
    end

    %% Conexões
    Cliente --- UC1
    Cliente --- UC2
    UC1 -.->|include| UC2
    UC2 -.->|include| UC3
    UC2 -.->|include| UC4

    UC2 --- Operadora
    UC4 --- Cozinheiro

    %% Estilização para o GitHub
    style Operadora fill:#f9f,stroke:#333
    style UC1 rx:20,ry:20
    style UC2 rx:20,ry:20
    style UC3 rx:20,ry:20
    style UC4 rx:20,ry:20
