graph LR
    Cliente((Cliente))
    Cozinheiro((Cozinheiro))
    Operadora[((Operadora Pagamento))]

    subgraph Totem [Sistema do Totem]
        UC1([Fazer Pedido])
        UC2([Realizar Pagamento])
        UC3([Atualizar Fidelidade])
        UC4([Monitor da Cozinha])
    end

    Cliente --- UC1
    Cliente --- UC2
    UC1 -.->|include| UC2
    UC2 -.->|include| UC3
    UC2 -.->|include| UC4

    UC2 --- Operadora
    UC4 --- Cozinheiro

    style Operadora fill:#f9f,stroke:#333
